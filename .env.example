# Back office (Ballons_Tunisie_Admin) — copy to ".env.local" if needed.
#
# URL of the API, WITHOUT trailing slash and WITHOUT "/api".
#   Local development: leave EMPTY. The Vite dev server (port 5173) proxies /api to
#                      http://localhost:3000, so start the API first.
#   Production:        the public API address, e.g. https://api.example.com
#                      (this origin must be listed in the API's FRONTEND_URL).
# This value is baked in at build time ("npm run build"): rebuild after changing it.
# Never put secrets here: every VITE_* variable is public in the browser.
VITE_API_URL=
